# ===== 服务端口 =====
PORT=8787

# ============================================================
# 安全加固（v1.1.3 起）：默认仅本地可用，公网暴露需显式配置
# ============================================================
# 监听地址：默认 127.0.0.1（仅本机）。公网部署请改为 0.0.0.0 并务必同时设置下方 API_TOKEN 与 CORS_ORIGINS
# HOST=127.0.0.1
# 可选 API 令牌：留空 = 本地信任模式（不校验，便于本机使用）；
# 设置后，除 /api/health 外的所有 /api 请求必须携带 Authorization: Bearer <token> 或 x-api-token: <token>，否则 401
# API_TOKEN=请改成强随机字符串
# 显式允许的跨域来源（逗号分隔的完整 origin，如 https://app.example.com）；
# 留空 = 仅允许同源与 localhost 来源（兼容 Vite dev 跨域），其余跨域一律拒绝
# CORS_ORIGINS=https://app.example.com,https://web.example.com

# ===== 数据目录（SQLite 数据库存放）=====
DATA_DIR=./data

# ===== 默认下载目录 =====
DOWNLOAD_DIR=./downloads

# ===== 下载引擎 =====
# auto    : 自动检测，优先 ytdlp，不可用则退回 simulate
# ytdlp   : 使用系统 yt-dlp 真实下载（需要安装 ffmpeg）
# simulate: 模拟下载（写入真实文件，用于无网络/测试环境）
DOWNLOAD_ENGINE=auto

# ===== 真实下载依赖的可执行文件路径 =====
# 留空则走 PATH 查找；若安装在非 PATH 目录（如 venv/pipx），填绝对路径
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# ===== 保留 HLS 临时分片（绕过沙箱/安全策略对批量删除的拦截）=====
# 设为 1 时，yt-dlp 不会自动清理 HLS 分片文件（--keep-fragments），可避开某些安全沙箱
# 在下载过程中因“批量删除临时文件”而杀死下载进程的问题。默认 0。
# 开启后请定期手动清理下载目录中的 *.part-Frag* 文件。
# YTDLP_KEEP_FRAGMENTS=1

# ===== 默认并发数 =====
MAX_CONCURRENT=3

# ===== 前端构建产物目录（生产模式由后端托管）=====
WEB_DIST=../web/dist

# ===== 日志级别 =====
LOG_LEVEL=info

# ============================================================
# v1.1.0 第三方 MITM 嗅探下载接入层（微信/抖音/小红书）
# 全部为可选项，缺省即按内置默认值工作；与现有功能完全隔离
# ============================================================
# 是否启用 MITM 接入层（0 关闭，默认开启）
MITM_ENABLED=1
# 是否桥接真实第三方 res-downloader（桌面应用，默认监听 127.0.0.1:8899）
# 不可达时自动降级为 offline，不影响内置无头下载引擎
MITM_BRIDGE=1
# MITM_BRIDGE_URL=http://127.0.0.1:8899
# 内置确定性 CDN 源（真实 mp4 + Range + 防盗链），用于验收/离线演示
MITM_FIXTURE=1
# MITM 产物独立目录（默认 ./downloads/mitm）
# MITM_DOWNLOAD_DIR=./downloads/mitm
# MITM 任务并发数
MITM_MAX_CONCURRENT=3
# 单次下载超时（毫秒）
MITM_TIMEOUT_MS=120000
# 本服务对外基址（用于拼接演示直链；Docker/反代场景按需改）
# MITM_BASE_URL=http://127.0.0.1:8787
# ffprobe 路径（产物双流校验用；留空走 PATH）
# MITM_FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# ============================================================
# 媒体探测 / 编码兼容性（v1.1.2 起）与路径安全（本轮新增）
# ============================================================
# 主任务链路 ffprobe 路径（留空走 PATH；用于下载后编码/可播放性探测）
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
# 主任务链路：检测到 AV1/VP9-in-MP4 等不兼容编码时自动转码为 H.264+AAC
# 默认开启，设为 0 则仅标记不兼容、由前端手动点击「修复」
# AUTO_REPAIR_INCOMPATIBLE=1
# simulate 引擎是否用 ffmpeg 生成可播放占位视频（0 关闭，默认开启）
# SIMULATE_USE_FFMPEG=1
# 单次请求超时秒数
# REQUEST_TIMEOUT=60
# 额外允许的保存/读取目录，逗号分隔的绝对路径（默认仅 DOWNLOAD_DIR）
# 用户提交的 saveDir 必须落在 DOWNLOAD_DIR 或此处列出的目录内
# ALLOWED_EXTRA_DIRS=/Users/me/Videos,/Volumes/Media
# MITM 链路：检测到不兼容编码时自动转码为 H.264+AAC（默认开启，设 0 仅标记）
# MITM_AUTO_REPAIR=1
# 严格环回模式：设 1 后禁止 127.0.0.1 / localhost / ::1 直链（SSRF 防护收紧）
# 注意：开启后内置 fixture 源与桥接自检不可用
# MITM_BLOCK_LOOPBACK=1
